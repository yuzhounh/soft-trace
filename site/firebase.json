{
  "hosting": {
    "site": "soft-trace",
    "public": "dist",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "vercel.json",
      "_headers"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
