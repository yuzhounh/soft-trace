<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SoftTrace.Core\SoftTrace.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SoftTrace.ico" />
    <None Update="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SoftTrace</AssemblyName>
    <Version>0.3.0</Version>
    <Product>SoftTrace</Product>
    <Description>轻量级 Windows 软件使用时间追踪工具</Description>
    <ApplicationIcon>Assets\SoftTrace.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
