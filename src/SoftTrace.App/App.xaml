<Application x:Class="SoftTrace.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D2330" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6C7383" />
        <SolidColorBrush x:Key="InputSurfaceBrush" Color="#F0F3FA" />
        <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#D3E3FD" />
    </Application.Resources>
</Application>