<Window x:Class="SoftTrace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoftTrace.App"
        mc:Ignorable="d"
        Title="SoftTrace" Icon="Assets/SoftTrace.ico" Height="700" Width="1000" MinHeight="580" MinWidth="820"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei" FontSize="15">
    <Window.Resources>
        <Style x:Key="RangeComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5DAE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ClosedBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <ContentPresenter Margin="10,0,30,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <Path Width="8" Height="4" Margin="0,0,11,0"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="#697180" StrokeThickness="1.4" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0" Padding="1"
                                        Background="White" BorderBrush="#D5DAE5" BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClosedBorder" Property="Background" Value="#F7F8FA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ClosedBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Margin="2,1"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0F3FA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E8EEFF" />
                                <Setter Property="Foreground" Value="#344BA8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleScrollRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VerticalScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBody" Margin="2,0"
                                Background="#C8CED9" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#AEB7C6" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#8F9BAD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HorizontalScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBody" Margin="0,2"
                                Background="#C8CED9" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#AEB7C6" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#8F9BAD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="ModernVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Width="10" Background="#F8F9FC">
                <Track x:Name="PART_Track" IsDirectionReversed="True"
                       ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource InvisibleScrollRepeatButtonStyle}"
                                      Command="{x:Static ScrollBar.PageUpCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource VerticalScrollThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource InvisibleScrollRepeatButtonStyle}"
                                      Command="{x:Static ScrollBar.PageDownCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="ModernHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Height="10" Background="#F8F9FC">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal"
                       ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource InvisibleScrollRepeatButtonStyle}"
                                      Command="{x:Static ScrollBar.PageLeftCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource HorizontalScrollThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource InvisibleScrollRepeatButtonStyle}"
                                      Command="{x:Static ScrollBar.PageRightCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style x:Key="ModernScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="#F8F9FC" />
            <Setter Property="Template" Value="{StaticResource ModernVerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template" Value="{StaticResource ModernHorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccountMenuButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="MenuItemBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuItemBackground" Property="Background" Value="#F0F2F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MenuItemBackground" Property="Background" Value="#E7EAF2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuItemBackground" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PagingButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5DAE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F3F5FA" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C9D0E0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5DAE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#344BA8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F4F6FC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#BCC6DF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E9EDF9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="SoftTrace" FontSize="32" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="软件使用时间，一目了然" Margin="1,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="15" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ImportButton" Content="导入"
                        Style="{StaticResource TopActionButtonStyle}"
                        ToolTip="导入 SoftTrace JSON 数据或 ManicTime 备份"
                        Click="ImportButton_OnClick" />
                <Button x:Name="ExportButton" Content="导出"
                        Style="{StaticResource TopActionButtonStyle}"
                        ToolTip="将活动记录导出为 SoftTrace JSON 数据包"
                        Click="ExportButton_OnClick" />
                <Grid>
                    <Button x:Name="GoogleSignInButton" Content="Google 登录"
                            Margin="0" Padding="15,8" Foreground="#344BA8"
                            FontSize="15" FontWeight="SemiBold" Click="GoogleSignInButton_OnClick" />
                <ToggleButton x:Name="CloudAccountButton" Visibility="Collapsed"
                              Width="44" Height="44" Background="Transparent"
                              BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="AvatarHover" Padding="3" Background="Transparent" CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="AvatarHover" Property="Background" Value="#E9EDF7" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="AvatarHover" Property="Background" Value="#E3E9F8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <Grid Width="36" Height="36">
                        <Ellipse x:Name="CloudAvatarEllipse" Fill="#E7ECFB"
                                 Stroke="#D5DAE8" StrokeThickness="1" />
                        <TextBlock x:Name="CloudAvatarFallbackText" Text="G"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#344BA8" FontWeight="SemiBold" FontSize="16" />
                    </Grid>
                </ToggleButton>
                <Popup x:Name="CloudAccountPopup" PlacementTarget="{Binding ElementName=CloudAccountButton}"
                       Placement="Bottom" HorizontalOffset="-184" VerticalOffset="8"
                       IsOpen="{Binding IsChecked, ElementName=CloudAccountButton, Mode=TwoWay}"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Width="240" Padding="16" Background="#FFFFFF"
                            BorderBrush="#E1E5EE" BorderThickness="1" CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="CloudDisplayNameText" Text="Google 用户"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold" FontSize="16" />
                            <TextBlock x:Name="CloudAccountText" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                            <Border Height="1" Margin="0,14,0,10" Background="#E8EBF1" />
                            <Button x:Name="SyncNowButton"
                                    Style="{StaticResource AccountMenuButtonStyle}"
                                    Margin="0,0,0,4" ToolTip="每 1 分钟自动同步"
                                    Click="SyncNowButton_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Stroke="#697180" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M 13.6,4.4 C 12.3,2.9 10.4,2 8.3,2 C 5.1,2 2.5,4.3 2,7.4 M 2,7.4 L 0.5,5.5 M 2,7.4 L 4.1,6.2 M 2.4,11.6 C 3.7,13.1 5.6,14 7.7,14 C 10.9,14 13.5,11.7 14,8.6 M 14,8.6 L 15.5,10.5 M 14,8.6 L 11.9,9.8" />
                                    </Viewbox>
                                    <TextBlock Text="立即同步" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <CheckBox x:Name="AutoStartCheckBox" Content="开机自启动"
                                      Margin="10,6,10,6" FontSize="14" Cursor="Hand"
                                      Foreground="{StaticResource TextBrush}"
                                      Click="AutoStartCheckBox_OnClick" />
                            <Button x:Name="GoogleSignOutButton"
                                    Style="{StaticResource AccountMenuButtonStyle}"
                                    Margin="0,4,0,0"
                                    Click="GoogleSignOutButton_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Stroke="#697180" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M 6,2 L 13,2 L 13,14 L 6,14 M 9,8 L 1,8 M 4,5 L 1,8 L 4,11" />
                                    </Viewbox>
                                    <TextBlock Text="退出账号" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Margin="0,12,0,0" Padding="10,8"
                                    Background="#F6F7FA" CornerRadius="6">
                                <TextBlock x:Name="CloudStatusText"
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13" LineHeight="22"
                                           LineStackingStrategy="BlockLineHeight" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>
                </Grid>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="开始日期" Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,0,0,6" />
                    <DatePicker x:Name="FromDatePicker" Width="150" Height="36"
                                CalendarStyle="{StaticResource LargeCalendarStyle}"
                                CalendarOpened="DatePicker_OnCalendarOpened"
                                SelectedDateChanged="DatePicker_OnSelectedDateChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="结束日期" Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,0,0,6" />
                    <DatePicker x:Name="ToDatePicker" Width="150" Height="36"
                                CalendarStyle="{StaticResource LargeCalendarStyle}"
                                CalendarOpened="DatePicker_OnCalendarOpened"
                                SelectedDateChanged="DatePicker_OnSelectedDateChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,20,0">
                    <TextBlock Text="范围" Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,0,0,6" />
                    <ComboBox x:Name="PeriodComboBox" Width="150" Height="36"
                              Style="{StaticResource RangeComboBoxStyle}"
                              SelectedIndex="0" Cursor="Hand" VerticalContentAlignment="Center"
                              SelectionChanged="PeriodComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="今天" Tag="Today" />
                        <ComboBoxItem Content="昨天" Tag="Yesterday" />
                        <ComboBoxItem Content="本周" Tag="ThisWeek" />
                        <ComboBoxItem Content="本月" Tag="ThisMonth" />
                        <ComboBoxItem Content="本季度" Tag="ThisQuarter" />
                        <ComboBoxItem Content="今年" Tag="ThisYear" />
                        <ComboBoxItem Content="近 7 天" Tag="Last7Days" />
                        <ComboBoxItem Content="近 30 天" Tag="Last30Days" />
                        <ComboBoxItem Content="近一季度" Tag="LastQuarter" />
                        <ComboBoxItem Content="近一年" Tag="LastYear" />
                        <ComboBoxItem Content="全部" Tag="All" />
                        <ComboBoxItem Content="自定义" Tag="Custom" Visibility="Collapsed" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,20,0">
                    <TextBlock Text="设备" Width="190" Margin="0,0,0,6"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                    <ToggleButton x:Name="DeviceFilterToggleButton" Width="190" Height="36" Content="当前设备"
                                  Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="DeviceFilterBorder" Background="#FFFFFF"
                                        BorderBrush="#D5DAE5" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Margin="10,0,30,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Path Width="8" Height="4" Margin="0,0,11,0"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="#697180" StrokeThickness="1.4" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DeviceFilterBorder" Property="Background" Value="#F7F8FA" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="DeviceFilterPopup"
                           PlacementTarget="{Binding ElementName=DeviceFilterToggleButton}"
                           Placement="Bottom" VerticalOffset="2"
                           IsOpen="{Binding IsChecked, ElementName=DeviceFilterToggleButton, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           Closed="DeviceFilterPopup_OnClosed">
                        <Border Width="230" MaxHeight="300" Padding="3"
                                Background="#FFFFFF" BorderBrush="#D5DAE5"
                                BorderThickness="1" CornerRadius="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DeviceFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="DeviceRow" Margin="1" Padding="9,6"
                                                    Background="Transparent" CornerRadius="5"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="DeviceFilterItem_OnMouseLeftButtonUp">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="DeviceNameText" Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBox x:Name="DeviceNameEditor"
                                                             Grid.Column="0" Grid.ColumnSpan="2"
                                                             Height="28" Padding="5,0" MaxLength="64"
                                                             Visibility="Collapsed"
                                                             Text="{Binding Name, Mode=OneTime}"
                                                             VerticalContentAlignment="Center"
                                                             BorderBrush="#AEBBE2" BorderThickness="1"
                                                             LostKeyboardFocus="DeviceNameEditor_OnLostKeyboardFocus"
                                                             KeyDown="DeviceNameEditor_OnKeyDown" />
                                                    <Button x:Name="DeviceEditButton" Grid.Column="1"
                                                            Width="25" Height="25" Margin="6,0,0,0"
                                                            Visibility="Collapsed" Background="Transparent"
                                                            BorderThickness="0" Cursor="Hand"
                                                            FocusVisualStyle="{x:Null}" ToolTip="编辑设备名称"
                                                            PreviewMouseLeftButtonDown="DeviceEditButton_OnPreviewMouseLeftButtonDown">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="{x:Type Button}">
                                                                <Border x:Name="EditButtonBackground"
                                                                        Background="Transparent" CornerRadius="4">
                                                                    <Path Width="13" Height="13" Stretch="Uniform"
                                                                          Stroke="#53699F" StrokeThickness="1.5"
                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          StrokeLineJoin="Round"
                                                                          Data="M 2,11 L 4.8,10.4 L 11.2,4 L 8,0.8 L 1.6,7.2 Z M 7.2,1.6 L 10.4,4.8" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="EditButtonBackground"
                                                                                Property="Background" Value="#DDE5F8" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="DeviceRow" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DeviceRow" Property="Background" Value="#F0F3FA" />
                                                    <Setter TargetName="DeviceEditButton" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="DeviceRow" Property="Background" Value="#E8EEFF" />
                                                    <Setter TargetName="DeviceNameText" Property="Foreground" Value="#344BA8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Id}" Value="">
                                                    <Setter TargetName="DeviceEditButton" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="CaptureStateText" Text="正在记录"
                               HorizontalAlignment="Right" TextAlignment="Right"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,0,0,6" />
                    <Border x:Name="CurrentAppBadge" HorizontalAlignment="Right"
                            Background="#F3F5FF" CornerRadius="14" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="CurrentAppIcon" Width="20" Height="20" Margin="0,0,8,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="CurrentAppNameText" Text="正在启动…"
                                       VerticalAlignment="Center" Foreground="#344BA8"
                                       FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="4,4,4,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="RangeSummaryText" Margin="0,36,0,0"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="总计" HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,0,0,3" />
                <TextBlock x:Name="TotalDurationText" Text="0 分钟" FontSize="16" FontWeight="Normal"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <local:RoundedClipBorder x:Name="UsageTableBorder" Grid.Row="3" VerticalAlignment="Stretch"
                                 Background="#F8F9FC"
                                 BorderBrush="#E6E9F0" BorderThickness="1" CornerRadius="11">
            <DataGrid x:Name="UsageDataGrid" ItemsSource="{Binding UsageRows}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" CanUserResizeColumns="True" SelectionUnit="FullRow"
                      PreviewMouseLeftButtonUp="UsageDataGrid_OnPreviewMouseLeftButtonUp"
                      Sorting="UsageDataGrid_OnSorting"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      BorderThickness="0" FocusVisualStyle="{x:Null}"
                      RowHeaderWidth="0" RowHeight="38" ColumnHeaderHeight="40"
                      Background="#F8F9FC" RowBackground="#FFFFFF"
                      AlternatingRowBackground="#FAFBFD"
                      ScrollViewer.CanContentScroll="False"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <Style x:Key="CenteredDataGridText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="8,0,0,0" />
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="TextWrapping" Value="NoWrap" />
                    </Style>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarStyle}" />
                </DataGrid.Resources>
                <DataGrid.Template>
                    <ControlTemplate TargetType="{x:Type DataGrid}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                        <Grid Background="#F8F9FC">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                                            Grid.Column="1"
                                                                            Visibility="{Binding HeadersVisibility, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}}" />
                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                    Grid.ColumnSpan="2" Grid.Row="1"
                                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="2" Grid.Row="1"
                                                       Orientation="Vertical"
                                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                                       Maximum="{TemplateBinding ScrollableHeight}"
                                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="1" Grid.Row="2"
                                                       Orientation="Horizontal"
                                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                                       Maximum="{TemplateBinding ScrollableWidth}"
                                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </DataGrid.Template>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#EEF0F5" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F4FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E9EEFC" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="ClipToBounds" Value="True" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8F9FC" />
                        <Setter Property="BorderBrush" Value="#E4E7ED" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border x:Name="HeaderBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            <Path x:Name="AscendingArrow" Visibility="Collapsed"
                                                  Width="8" Height="4" Margin="0,0,10,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Fill="#7B8494" Data="M 0 4 L 4 0 L 8 4 Z" />
                                            <Path x:Name="DescendingArrow" Visibility="Collapsed"
                                                  Width="8" Height="4" Margin="0,0,10,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Fill="#7B8494" Data="M 0 0 L 4 4 L 8 0 Z" />
                                            <Thumb x:Name="PART_LeftHeaderGripper" Width="8"
                                                   HorizontalAlignment="Left" Background="Transparent"
                                                   Cursor="SizeWE">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="Transparent" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                            <Thumb x:Name="PART_RightHeaderGripper" Width="8"
                                                   HorizontalAlignment="Right" Background="Transparent"
                                                   Cursor="SizeWE">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="Transparent" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="DisplayIndex" Value="3">
                                            <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="0,0,0,1" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#EEF1F7" />
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Ascending">
                                            <Setter TargetName="AscendingArrow" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Descending">
                                            <Setter TargetName="DescendingArrow" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="软件" Width="*" MinWidth="240"
                                            SortMemberPath="AppName" CanUserSort="True" CanUserResize="True">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="软件" Margin="29,0,0,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,9,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding AppName}" VerticalAlignment="Center" FontSize="15" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="180" MinWidth="120"
                                        CanUserResize="True"
                                        SortMemberPath="ProcessName"
                                        ElementStyle="{StaticResource CenteredDataGridText}" />
                    <DataGridTextColumn Header="使用时长" Binding="{Binding DurationText}" Width="130" MinWidth="100"
                                        CanUserResize="True"
                                        SortMemberPath="DurationSeconds"
                                        ElementStyle="{StaticResource CenteredDataGridText}" />
                    <DataGridTextColumn Header="占比" Binding="{Binding ShareText}" Width="95" MinWidth="75"
                                        CanUserResize="True"
                                        SortMemberPath="ShareRatio"
                                        ElementStyle="{StaticResource CenteredDataGridText}" />
                </DataGrid.Columns>
            </DataGrid>
        </local:RoundedClipBorder>

        <!-- Pagination Controls Bar -->
        <Grid Grid.Row="4" Margin="4,12,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PaginationSummaryText" Text="共 0 条记录"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="，每页" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0" />
                <ComboBox x:Name="PageSizeComboBox" Width="70" Height="28" Margin="6,0,0,0"
                          VerticalContentAlignment="Center" FontSize="13"
                          SelectionChanged="PageSizeComboBox_OnSelectionChanged">
                    <ComboBoxItem Content="20" />
                    <ComboBoxItem Content="50" IsSelected="True" />
                    <ComboBoxItem Content="100" />
                    <ComboBoxItem Content="200" />
                </ComboBox>
                <TextBlock Text="条" Foreground="{StaticResource MutedTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="FirstPageButton" Content="首页" Style="{StaticResource PagingButtonStyle}"
                        Click="FirstPageButton_OnClick" />
                <Button x:Name="PreviousPageButton" Content="上一页" Style="{StaticResource PagingButtonStyle}"
                        Click="PreviousPageButton_OnClick" />
                <TextBlock x:Name="PageNumberText" Text="第 1 / 1 页"
                           Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0" />
                <Button x:Name="NextPageButton" Content="下一页" Style="{StaticResource PagingButtonStyle}"
                        Click="NextPageButton_OnClick" />
                <Button x:Name="LastPageButton" Content="末页" Style="{StaticResource PagingButtonStyle}"
                        Click="LastPageButton_OnClick" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
