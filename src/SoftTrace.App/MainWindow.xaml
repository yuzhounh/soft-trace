<Window x:Class="SoftTrace.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoftTrace.App"
        mc:Ignorable="d"
        Title="SoftTrace" Height="680" Width="980" MinHeight="560" MinWidth="800"
        Background="{StaticResource PageBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="RangeComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D5DAE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ClosedBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <ContentPresenter Margin="10,0,30,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <Path Width="8" Height="4" Margin="0,0,11,0"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="#697180" StrokeThickness="1.4" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0" Padding="1"
                                        Background="White" BorderBrush="#D5DAE5" BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClosedBorder" Property="Background" Value="#F7F8FA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ClosedBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Margin="2,1"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0F3FA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E8EEFF" />
                                <Setter Property="Foreground" Value="#344BA8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleScrollRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VerticalScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBody" Margin="2,0"
                                Background="#C8CED9" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#AEB7C6" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#8F9BAD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HorizontalScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBody" Margin="0,2"
                                Background="#C8CED9" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#AEB7C6" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#8F9BAD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="ModernVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Width="10" Background="#F8F9FC">
                <Track x:Name="PART_Track" IsDirectionReversed="True"
                       ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource InvisibleScrollRepeatButtonStyle}"
                                      Command="{x:Static ScrollBar.PageUpCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource VerticalScrollThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource InvisibleScrollRepeatButtonStyle}"
                                      Command="{x:Static ScrollBar.PageDownCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="ModernHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Height="10" Background="#F8F9FC">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal"
                       ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource InvisibleScrollRepeatButtonStyle}"
                                      Command="{x:Static ScrollBar.PageLeftCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource HorizontalScrollThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource InvisibleScrollRepeatButtonStyle}"
                                      Command="{x:Static ScrollBar.PageRightCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style x:Key="ModernScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="#F8F9FC" />
            <Setter Property="Template" Value="{StaticResource ModernVerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template" Value="{StaticResource ModernHorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="SoftTrace" FontSize="30" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="软件使用时间，一目了然" Margin="1,5,0,0"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
            </StackPanel>
            <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="GoogleSignInButton" Content="Google 登录"
                        Margin="0" Padding="14,7" Foreground="#344BA8"
                        FontWeight="SemiBold" Click="GoogleSignInButton_OnClick" />
                <ToggleButton x:Name="CloudAccountButton" Visibility="Collapsed"
                              Width="42" Height="42" Background="Transparent"
                              BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="AvatarHover" Padding="3" Background="Transparent" CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="AvatarHover" Property="Background" Value="#E9EDF7" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="AvatarHover" Property="Background" Value="#E3E9F8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <Grid Width="34" Height="34">
                        <Ellipse x:Name="CloudAvatarEllipse" Fill="#E7ECFB"
                                 Stroke="#D5DAE8" StrokeThickness="1" />
                        <TextBlock x:Name="CloudAvatarFallbackText" Text="G"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#344BA8" FontWeight="SemiBold" />
                    </Grid>
                </ToggleButton>
                <Popup x:Name="CloudAccountPopup" PlacementTarget="{Binding ElementName=CloudAccountButton}"
                       Placement="Bottom" HorizontalOffset="-238" VerticalOffset="7"
                       IsOpen="{Binding IsChecked, ElementName=CloudAccountButton, Mode=TwoWay}"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Width="280" Padding="16" Background="#FFFFFF"
                            BorderBrush="#E1E5EE" BorderThickness="1" CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="CloudAccountText" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="CloudStatusText" Margin="0,6,0,14"
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SyncNowButton" Content="立即同步" Margin="0,0,7,0"
                                        Padding="10,5" ToolTip="每 1 分钟自动同步"
                                        Click="SyncNowButton_OnClick" />
                                <Button x:Name="GoogleSignOutButton" Content="退出登录" Margin="0"
                                        Padding="10,5" Click="GoogleSignOutButton_OnClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="开始日期" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                    <DatePicker x:Name="FromDatePicker" Width="145" SelectedDateChanged="DatePicker_OnSelectedDateChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <TextBlock Text="结束日期" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                    <DatePicker x:Name="ToDatePicker" Width="145" SelectedDateChanged="DatePicker_OnSelectedDateChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,18,0">
                    <TextBlock Text="范围" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                    <ComboBox x:Name="PeriodComboBox" Width="145" Height="32"
                              Style="{StaticResource RangeComboBoxStyle}"
                              SelectedIndex="0" Cursor="Hand" VerticalContentAlignment="Center"
                              SelectionChanged="PeriodComboBox_OnSelectionChanged">
                        <ComboBoxItem Content="今天" Tag="Today" />
                        <ComboBoxItem Content="本周" Tag="ThisWeek" />
                        <ComboBoxItem Content="本月" Tag="ThisMonth" />
                        <ComboBoxItem Content="本季度" Tag="ThisQuarter" />
                        <ComboBoxItem Content="今年" Tag="ThisYear" />
                        <ComboBoxItem Content="近 7 天" Tag="Last7Days" />
                        <ComboBoxItem Content="近 30 天" Tag="Last30Days" />
                        <ComboBoxItem Content="近一季度" Tag="LastQuarter" />
                        <ComboBoxItem Content="近一年" Tag="LastYear" />
                        <ComboBoxItem Content="全部" Tag="All" />
                        <ComboBoxItem Content="自定义" Tag="Custom" Visibility="Collapsed" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,18,0">
                    <TextBlock Text="设备" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                    <ComboBox x:Name="DeviceFilterComboBox" Width="145" Height="32"
                              Style="{StaticResource RangeComboBoxStyle}"
                              ItemsSource="{Binding DeviceFilters}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" Cursor="Hand" VerticalContentAlignment="Center"
                              SelectionChanged="DeviceFilterComboBox_OnSelectionChanged" />
                </StackPanel>
                <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                    <TextBlock x:Name="CaptureStateText" Text="正在记录"
                               HorizontalAlignment="Right" TextAlignment="Right"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                    <Border x:Name="CurrentAppBadge" HorizontalAlignment="Right"
                            Background="#F3F5FF" CornerRadius="14" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="CurrentAppIcon" Width="18" Height="18" Margin="0,0,7,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="CurrentAppNameText" Text="正在启动…"
                                       VerticalAlignment="Center" Foreground="#344BA8"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="4,4,4,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="软件使用排行" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="RangeSummaryText" Margin="0,5,0,0"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="总计" HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="TotalDurationText" Text="0 分钟" FontSize="18" FontWeight="Normal"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <local:RoundedClipBorder Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                                 BorderBrush="#E6E9F0" BorderThickness="1" CornerRadius="11">
            <DataGrid x:Name="UsageDataGrid" ItemsSource="{Binding UsageRows}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      BorderThickness="0" FocusVisualStyle="{x:Null}"
                      RowHeaderWidth="0" RowHeight="34" ColumnHeaderHeight="36"
                      Background="#F8F9FC" RowBackground="#FFFFFF"
                      AlternatingRowBackground="#FAFBFD"
                      HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Resources>
                    <Style x:Key="CenteredDataGridText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBarStyle}" />
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#EEF0F5" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F4FC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E9EEFC" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="7,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8F9FC" />
                        <Setter Property="BorderBrush" Value="#E4E7ED" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Padding" Value="7,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border x:Name="HeaderBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            <Path x:Name="AscendingArrow" Visibility="Collapsed"
                                                  Width="8" Height="4" Margin="0,0,10,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Fill="#7B8494" Data="M 0 4 L 4 0 L 8 4 Z" />
                                            <Path x:Name="DescendingArrow" Visibility="Collapsed"
                                                  Width="8" Height="4" Margin="0,0,10,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Fill="#7B8494" Data="M 0 0 L 4 4 L 8 0 Z" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#EEF1F7" />
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Ascending">
                                            <Setter TargetName="AscendingArrow" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Descending">
                                            <Setter TargetName="DescendingArrow" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="软件" Width="*" SortMemberPath="AppName" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,9,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding AppName}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="180"
                                        SortMemberPath="ProcessName"
                                        ElementStyle="{StaticResource CenteredDataGridText}" />
                    <DataGridTextColumn Header="使用时长" Binding="{Binding DurationText}" Width="130"
                                        SortMemberPath="DurationSeconds"
                                        ElementStyle="{StaticResource CenteredDataGridText}" />
                    <DataGridTextColumn Header="占比" Binding="{Binding ShareText}" Width="90"
                                        SortMemberPath="ShareRatio"
                                        ElementStyle="{StaticResource CenteredDataGridText}" />
                </DataGrid.Columns>
            </DataGrid>
        </local:RoundedClipBorder>

    </Grid>
</Window>
